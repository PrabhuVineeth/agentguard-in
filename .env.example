# AgentGuard-IN Environment Variables Template
# Copy this file to .env and insert your personal API keys if using cloud adapters.

# Groq Cloud API Key (Optional: for Meta Prompt Guard 2 / cloud LLM experiments)
# Obtain a key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional: for GPT baseline evaluations)
# OPENAI_API_KEY=your_openai_api_key_here

# Random Seed for Reproducibility
AGENTGUARD_SEED=42

